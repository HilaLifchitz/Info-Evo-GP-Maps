Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "PARAMETERS", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "=", "1.2"}], ";", " ", 
    RowBox[{"K", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Logistic", " ", "growth"}], ",", " ", 
     RowBox[{"first", " ", "=", "  ", 
      RowBox[{
      "we", " ", "assign", " ", "the", " ", "logistic", " ", "equation", " ", 
       "to", " ", "eq"}]}], ",", " ", 
     RowBox[{
      RowBox[{"and", " ", "then"}], " ", "==", " ", 
      RowBox[{"defines", " ", "the", " ", "eqaution"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eq", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{"r", " ", 
       RowBox[{"x", "[", "t", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", " ", 
         RowBox[{
          RowBox[{"x", "[", "t", "]"}], "/", "K"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ic", " ", "=", " ", 
     RowBox[{
      RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "0.05"}]}], 
    ";"}]}]}]], "Input",

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Clearing", " ", "all", " ", 
    RowBox[{"variables", " ", "--"}], " ", "a", " ", "good", " ", "thing", " ",
     "to", " ", "start", " ", "your", " ", "files", " ", "with"}], "*)"}], 

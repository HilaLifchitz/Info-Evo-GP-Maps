Cell["\<\
sol = NDSolve[{eq, ic}, x, {t, 0, 10}];
Plot[Evaluate[x[t] /. sol], {t, 0, 10},
 AxesLabel -> {\[OpenCurlyDoubleQuote]t\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]x(t)\[CloseCurlyDoubleQuote]}, PlotRange -> All]\
\[LineSeparator]\
\>", "Text",

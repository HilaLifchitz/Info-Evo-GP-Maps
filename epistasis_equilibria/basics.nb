  RowBox[{"free_fitness", "[", 
   RowBox[{"p_", ",", "Ne_", ",", "Vi_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"NIntegrate", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", "x", "]"}], "*", 

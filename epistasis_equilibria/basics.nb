Cell[CellGroupData[{

Cell["Same with the free fitness for the Equilibrium", "Subsubsection",
 CellChangeTimes->{{3.985849437523838*^9, 
  3.985849462546885*^9}},ExpressionUUID->"55d647f6-246e-460a-b338-\
a7f5a26b7dfb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"freeFitnessNS", "[", 
    RowBox[{
     RowBox[{"Ne_", "?", "NumericQ"}], ",", 
     RowBox[{"s_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Z", ",", "rho", ",", "rhoTilde", ",", "V"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"V", "[", "x_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "Ne"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"W", "[", 
           RowBox[{"x", ",", "s"}], "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", " ", "Ne", " ", "u"}]}], ")"}], " ", 
         RowBox[{"Log", "[", "x", "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", " ", "Ne", " ", "v"}]}], ")"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "x"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rhoTilde", "[", "x_", "]"}], ":=", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"V", "[", "x", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"Z", "=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"rhoTilde", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"rhoTilde", "[", "x", "]"}], "/", "Z"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"freeFit", "=", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"NIntegrate", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"rho", "[", "x", "]"}], "*", 
            FractionBox[
             RowBox[{"V", "[", "x", "]"}], "Ne"]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0.000", ",", "1"}], "}"}]}], "]"}]}], "-", 
        RowBox[{
         FractionBox["1", "Ne"], " ", "*", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rho", "[", "x", "]"}], "*", 
            RowBox[{"Log", "[", 
             RowBox[{"rho", "[", "x", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0.000", ",", "1"}], "}"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", "freeFit"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.985849465809376*^9, 3.985849470861899*^9}, 
   3.985849518521029*^9, {3.98584959818929*^9, 3.985849651283367*^9}, {
   3.985849700850398*^9, 3.9858497794422493`*^9}, {3.98584986478714*^9, 
   3.985849878993778*^9}},
 CellLabel->
  "In[636]:=",ExpressionUUID->"6bb28a2e-59fe-4bf6-940d-916f4a533d36"],


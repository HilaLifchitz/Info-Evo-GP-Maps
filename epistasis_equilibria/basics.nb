Cell[BoxData[{
 RowBox[{"Clear", "[", "misoInf", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"misoInf", "[", 
    RowBox[{
     RowBox[{"Ne_", "?", "NumericQ"}], ",", 
     RowBox[{"s_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Z", ",", "rho", ",", "pBins", ",", "H", ",", "edges", ",", "rhoTilde", 
       ",", "V", ",", "Zn", ",", "qBins", ",", "rhoNeut"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"V", "[", 
        RowBox[{"x_", ",", "Ne", ",", "s"}], "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", " ", "Ne"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"W", "[", 
           RowBox[{"x", ",", "s"}], "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", " ", "Ne", " ", "u"}]}], ")"}], " ", 
         RowBox[{"Log", "[", "x", "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", " ", "Ne", " ", "v"}]}], ")"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "-", "x"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rhoTilde", "[", 
        RowBox[{"x_", ",", "Ne", ",", "s"}], "]"}], ":=", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"V", "[", 
          RowBox[{"x", ",", "Ne", ",", "s"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"edges", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"0", ",", "1", ",", "Ne"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Z", "=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"rhoTilde", "[", 
          RowBox[{"x", ",", "Ne", ",", "s"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"rhoTilde", "[", 
         RowBox[{"x", ",", "Ne", ",", "s"}], "]"}], "/", "Z"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Zn", " ", "=", " ", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"rhoTilde", "[", 
          RowBox[{"x", ",", "Ne", ",", "0"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rhoNeut", "[", "x_", "]"}], ":=", 
       RowBox[{
        RowBox[{"rhoTilde", "[", 
         RowBox[{"x", ",", "Ne", ",", "0"}], "]"}], "/", "Zn"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qBins", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"rhoNeut", "[", "x", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"edges", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"edges", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nBins"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qBins", "=", 
       RowBox[{"qBins", "/", 
        RowBox[{"Total", "[", "qBins", "]"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"pBins", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"rho", "[", "x", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"edges", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"edges", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nBins"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pBins", "=", 
       RowBox[{"pBins", "/", 
        RowBox[{"Total", "[", "pBins", "]"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"H", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"pBins", "*", 
         RowBox[{"Log", "[", 
          RowBox[{"2", ",", 
           RowBox[{"pBins", "/", "qBins"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "H"}]}], "]"}]}], ";"}]}], "Input",

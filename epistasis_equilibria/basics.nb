Cell[BoxData[
 RowBox[{
  RowBox[{"a", "[", "x_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"(", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}]}], ")"}], "2"], "*", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"W", "[", "x", "]"}], "]"}], ",", "x"}], "]"}]}], " ", "+", 
   " ", 
   RowBox[{"u", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}], " ", "-", " ", 
   RowBox[{"v", " ", "x", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"u", ":", " ", 
        RowBox[{"mutation", " ", "[", "0", "]"}]}], " ", "->", 
       RowBox[{
        RowBox[{
         RowBox[{"[", "1", "]"}], ".", " ", 
         RowBox[{"v", ":", " ", 
          RowBox[{"[", "1", "]"}]}]}], "->", 

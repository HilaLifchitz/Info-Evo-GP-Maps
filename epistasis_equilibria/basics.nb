Cell[TextData[{
 "so, specifically for this case we will always the uniform distribution= the \
equilibrium under neutrality u(x)=",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"|", "\[CapitalOmega]", "|"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8bbbe6de-505c-4792-83e8-27f86ffcab15"],
 "where \[CapitalOmega] is the space we are at \[LineSeparator](either the \
HIlberts cube ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"[", 
     RowBox[{"0", ",", "1"}], "]"}], "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d07b27d5-cfcd-442f-aa81-f07ae91017df"],
 " or the simplex ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]", 
    RowBox[{
     SuperscriptBox["2", "n"], "-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "77a23f6b-07e8-4c7d-94c3-9a6caea65bf2"],
 ") and |\[CapitalOmega]| means its volume (this is =1 for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"[", 
     RowBox[{"0", ",", "1"}], "]"}], "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d811a86-be21-435b-bad6-912ebb157765"],
 " and ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"n", "-", "1"}], ")"}], "!"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "279e2645-2248-461b-944c-45c0720b416f"],
 " for the (n-1) dimensional simplex ). Then we can pull |\[CapitalOmega]| \
from the integral and we get a general expression\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          RowBox[{
            StyleBox["K", "TI"], 
            StyleBox["L", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Rho]", "\[Infinity]"], "||", 
             SubscriptBox["\[Rho]", "0"]}], ")"}], "\[LongEqual]", 
         StyleBox["l", "TI"], 
         StyleBox["o", "TI"], 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{"|\[AHat]\[Hyphen]\[DoubleDot]", 
             StyleBox["e", "TI"], 
             StyleBox["g", "TI"], 
             StyleBox["a", "TI"], "|"}], ")"}], "-", 
         StyleBox["S", "TI"], 
         RowBox[{"(", 
           SubscriptBox["\[Rho]", "\[Infinity]"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "D_{KL}(\\rho_{\\infty}||\\rho_{0}}) = log(|\\Om\[LineSeparator]ega|) - \
S(\\rho_{\\infty})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7651bb4c-ec97-44fc-b63c-81403f545250"],
 " up to the base of the log.\[LineSeparator]\[LineSeparator] To calculate \
the entropy we need to specify all of the parameters of the diffusion u,v,N \
and also how to fitness is determined.\n"
}], "Text",
 CellChangeTimes->{{3.985761965536292*^9, 3.985762274434898*^9}, {
   3.9857623296362953`*^9, 3.98576237785767*^9}, {3.98576444059986*^9, 
   3.985764448805608*^9}, {3.985834193069742*^9, 3.985834312415634*^9}, 
   3.9858582115506887`*^9},ExpressionUUID->"dd779446-4e2e-430b-ac09-\
5f0de801389c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ne", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "=", " ", "0.0001"}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Miso", " ", "had", " ", "mu"}], " ", "=", " ", 
    RowBox[{"v", "=", 
     RowBox[{"u", "=", 
      RowBox[{"0.0001", "!!"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 

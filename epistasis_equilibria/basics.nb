Cell[BoxData[{
 RowBox[{"Clear", "[", "KLInterval", "]"}], "\n", 
 RowBox[{
  RowBox[{"KLInterval", "[", 
   RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "x", "]"}], "*", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"p", "[", "x", "]"}], 
       RowBox[{"q", "[", "x", "]"}]], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9857611197233763`*^9, 3.985761119723405*^9}, {

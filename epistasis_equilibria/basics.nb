Cell[BoxData[
 RowBox[{"First", " ", "we", " ", "need", " ", "to", " ", "bin", " ", "the", " ",
   "probability", " ", "with", " ", "bins", " ", "with", " ", "width", " ", 
  FractionBox["1", "Ne"]}]], "Text",
 CellChangeTimes->{{3.985840175608821*^9, 
  3.985840195792357*^9}},ExpressionUUID->"c9bd174f-5a1d-464b-9dcb-\
8047657129ff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nBins", "=", "Ne"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edges", "=", 
    RowBox[{"Subdivide", "[", 
     RowBox[{"0", ",", "1", ",", "nBins"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"probability", " ", "in", " ", "each", " ", "bin"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pBins", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "Ne", ",", "s"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"edges", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"edges", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nBins"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "normalize", " ", "just", " ", "in", " ", "case", " ", "of", " ", "tiny", " ",
     "numerical", " ", "drift"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pBins", "=", 
    RowBox[{"pBins", "/", 
     RowBox[{"Total", "[", "pBins", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "discrete", " ", "Shannon", " ", "entropy", " ", "of", " ", "the", " ", 
    "bin", " ", 
    RowBox[{"distribution", " ", "--"}], " ", "THIS", " ", "SHOULD", " ", 
    "NOW", " ", "BE", " ", "POSITIVE", " ", "AND", " ", "HOPFULLY", " ", 
    "MATCH", " ", 
    RowBox[{"MISO", "'"}], "S", " ", "RESULTS", " ", "IN", " ", "FIGURE", " ",
     "5", "A"}], "*)"}]}], "\n", 
 RowBox[{"Hbins", "=", 
  RowBox[{"-", 
   RowBox[{"Total", "[", 
    RowBox[{"pBins", "*", 
     RowBox[{"Log", "[", 
      RowBox[{"2", ",", "pBins"}], "]"}]}], "]"}], " "}]}]}], "Input",
 CellChangeTimes->{{3.985840218019548*^9, 3.985840231674165*^9}, {
  3.985840839037035*^9, 3.9858408506702547`*^9}},

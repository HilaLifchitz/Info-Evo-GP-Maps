              RowBox[{"--", 
               RowBox[{"--", 
                RowBox[{"--", "-"}]}]}]}]}]}]}]}]}]}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Domain", " ", "clip", " ", "to", " ", "avoid", " ", "log", " ", 
      "singularities", " ", "exactly", " ", "at", " ", "0"}], ",", "1"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eps", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Replace", " ", "this", " ", "with", " ", "your", " ", "fitness", " ", 
     "W", 
     RowBox[{"(", 
      RowBox[{"x", ",", "s"}], ")"}], " ", "from", " ", "your", " ", 
     "notebook"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"W", "[", 
     RowBox[{"x_", ",", "s_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", "s"}], ")"}], " ", "x"}], " ", "+", 
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}]}]}], " ", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Parameters", " ", "u"}], ",", 
     RowBox[{
      RowBox[{"v", " ", "are", " ", "mutation", " ", "rates"}], ";", 
      RowBox[{
      "keep", " ", "or", " ", "replace", " ", "as", " ", "needed"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "4"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "4"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Potential", " ", "V", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", ";", "N"}], ",", "s"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"edit", " ", "to", " ", "your", " ", "exact", " ", 
       RowBox[{"formula", "/", "convention"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"V", "[", 
      RowBox[{"x_", ",", "Ne_", ",", "s_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", "Ne"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"W", "[", 
         RowBox[{"x", ",", "s"}], "]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "Ne", " ", "u"}]}], ")"}], " ", 
       RowBox[{"Log", "[", "x", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "Ne", " ", "v"}]}], ")"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "-", "x"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Unnormalized", " ", "rho"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rhoTilde", "[", 
      RowBox[{"x_", ",", "Ne_", ",", "s_"}], "]"}], ":=", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
       RowBox[{"V", "[", 
        RowBox[{"x", ",", "Ne", ",", "s"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Normalization", " ", "constant", " ", "Z", 
       RowBox[{"(", 
        RowBox[{"N", ",", "s"}], ")"}], "\[IndentingNewLine]", 
       RowBox[{"Z", "[", 
        RowBox[{
         RowBox[{"N_", "?", "NumericQ"}], ",", 
         RowBox[{"s_", "?", "NumericQ"}]}], "]"}]}], ":=", 
      RowBox[{
       RowBox[{"Z", "[", 
        RowBox[{"N", ",", "s"}], "]"}], "=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"rhoTilde", "[", 
          RowBox[{"x", ",", "N", ",", "s"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "eps", ",", 
           RowBox[{"1", "-", "eps"}]}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}], ",", 
         RowBox[{"MaxRecursion", "->", "20"}], ",", 
         RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}], ";"}], " ", 
    "*)"}], "\n", 
   RowBox[{"Z", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"-", " ", 
        RowBox[{"V", "[", 
         RowBox[{"x", ",", "100", ",", "0.01"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0.000", ",", "1"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Normalized", " ", "rho", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", ";", "N"}], ",", "s"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rho", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"Ne_", "?", "NumericQ"}], ",", 
       RowBox[{"s_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"rhoTilde", "[", 
       RowBox[{"x", ",", "Ne", ",", "s"}], "]"}], "/", "Z"}]}], ";"}], 
   " "}]}]], "Input",

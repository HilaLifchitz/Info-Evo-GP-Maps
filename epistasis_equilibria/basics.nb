Cell[TextData[{
 "So we are getting a negative result because we are taking continuous \
entropy, let us try to bin the distribution artificially to bins that are the \
width of ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "Ne"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b638a31-3603-4a54-a866-0db5c7476519"],
 " "
}], "Text",
 CellChangeTimes->{{3.985838212221939*^9, 3.985838254205946*^9}, {
  3.985838393463126*^9, 
  3.985838406600616*^9}},ExpressionUUID->"99949f1d-5714-44e3-bfbf-\
7b1cc1c35a75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"define", " ", 
    RowBox[{"p", "[", "x_", "]"}], " ", "before", " ", "this"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"bin", " ", "edges"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nBins", "=", "Ne"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"edges", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0", ",", "1", ",", "nBins"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"probability", " ", "in", " ", "each", " ", "bin"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pBins", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"\[Rho]", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"edges", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"edges", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nBins"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "normalize", " ", "just", " ", "in", " ", "case", " ", "of", " ", "tiny", 
     " ", "numerical", " ", "drift"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pBins", "=", 
     RowBox[{"pBins", "/", 
      RowBox[{"Total", "[", "pBins", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "discrete", " ", "Shannon", " ", "entropy", " ", "of", " ", "the", " ", 
     "bin", " ", 
     RowBox[{"distribution", " ", "--"}], " ", "THIS", " ", "SHOULD", " ", 
     "NOW", " ", "BE", " ", "POSITIVE", " ", "AND", " ", "HOPFULLY", " ", 
     "MATCH", " ", 
     RowBox[{"MISO", "'"}], "S", " ", "RESULTS", " ", "IN", " ", "FIGURE", " ",
      "5", "A"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Hbins", "=", 
    RowBox[{"-", 
     RowBox[{"Total", "[", 
      RowBox[{"pBins", "*", 
       RowBox[{"Log", "[", "pBins", "]"}]}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9858384209597178`*^9, 3.98583845764637*^9}, 
   3.98583863441214*^9, {3.985839591287421*^9, 
   3.985839618636656*^9}},ExpressionUUID->"03ea526a-975a-4922-8bc9-\
36e7084758e3"],


Cell[BoxData[{
 RowBox[{"Lets", " ", "see", " ", "how", " ", "much", " ", "information", " ",
   "we", " ", "have", " ", "accumulated", " ", "and", " ", "how", " ", "much",
   " ", "free", " ", "fitness", " ", "had", " ", 
  RowBox[{"accumulated", "!"}]}], "\[IndentingNewLine]", 
 RowBox[{"For", " ", 
  RowBox[{"Miso", "'"}], "s", " ", "defintion", " ", "of", " ", "information",
   " ", "we", " ", "measure", " ", "the", " ", "KL", " ", "divergence", 
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
